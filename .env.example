# ── Supabase (browser-safe) ─────────────────────────────────────────────
# One Supabase project PER BRAND. Fashion and Luxury must never share a
# database: the campaigns, uploads and resets are entirely separate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Brand ───────────────────────────────────────────────────────────────
# "fashion" or "luxury". Controls the product title on the login page, in
# the sidebar and in the browser tab — nothing else. Defaults to "fashion"
# when unset or unrecognised, so an existing deployment keeps working.
# NEXT_PUBLIC_ is required because the title renders in the browser.
NEXT_PUBLIC_BRAND=fashion

# ── Server-only ─────────────────────────────────────────────────────────
# Used by app/api/performance-analysis/route.ts. Never prefix with
# NEXT_PUBLIC_; the browser must never see this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
