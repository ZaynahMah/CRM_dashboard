NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — used by app/api/performance-analysis/route.ts. Never prefix
# with NEXT_PUBLIC_; the browser must never see this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Batch uploads (Part A) ─────────────────────────────────────────────
# Add-only uploads are now the DEFAULT — no variable needed.
# Set this to "true" ONLY to fall back to the old replace-running-PNs
# upload. Leave it unset in normal operation.
# NEXT_PUBLIC_ is inlined at BUILD time, so changing it needs a redeploy.
# NEXT_PUBLIC_LEGACY_UPLOAD_ENABLED=false
