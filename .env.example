NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — used by app/api/performance-analysis/route.ts. Never prefix
# with NEXT_PUBLIC_; the browser must never see this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Batch uploads (Part A) ─────────────────────────────────────────────
# "true" switches CRM uploads to add-only add_upload_batch() and shows
# "Reset last upload". Anything else (including unset) keeps the existing
# upload exactly as it is today — one variable to roll back.
# NEXT_PUBLIC_ is inlined at BUILD time, so changing it needs a redeploy.
NEXT_PUBLIC_BATCH_UPLOAD_ENABLED=false
